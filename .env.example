# Sao chép file này thành .env (hoặc khai báo trong Vercel > Settings > Environment Variables)
# KHÔNG commit file .env thật lên GitHub.

# Lấy ở Supabase > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# anon key: được phép nằm ở phía trình duyệt, an toàn nhờ RLS trong supabase_schema.sql
SUPABASE_ANON_KEY=your-anon-public-key

# CẢNH BÁO: tuyệt đối KHÔNG đặt service_role key vào frontend hoặc commit lên Git.
# SUPABASE_SERVICE_ROLE_KEY=
